<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Starts the game's own Unity Mono runtime from the declared WotR inputs and runs a program (the test runner) on it.
    Contains no game files and references none: the runtime library is loaded from the installation at run time.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <RootNamespace>WotR.Testing.MonoHost</RootNamespace>
    <AssemblyName>wotr-mono-host</AssemblyName>
    <IsPackable>false</IsPackable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
