<Project TreatAsLocalProperty="VSTestSetting;VSTestTestAdapterPath;VSTestConsolePath">

  <!--
    WotR offline testing: locates the game inputs, adds compile-time game references and writes
    wotr-offline-inputs.json next to the test assembly.

    Consumer properties:
      WotrModAssembly        Required in test projects: path to the built mod DLL. Its Info.json and private
                             dependencies (for example BlueprintCore.dll) are read from the same directory.
      WotrDependencyMod      Items: other mods' built DLLs loaded with it, for example a framework mod named in its
                             Info.json Requirements. All mods load in Requirements/LoadAfter order.
      WotrInputRoot          Game root (installation or snapshot). Otherwise WOTR_INPUT_ROOT, then
                             WotrSnapshotDirectory if it contains manifest.json, then WrathInstallDir/WrathPath/WRATH_PATH.
      WotrSnapshotDirectory  Optional snapshot created by New-WotrSnapshot.ps1.
      WotrWorkDirectory      Runtime cache and per-run state. Default: $(BaseIntermediateOutputPath)wotr/.
      WotrReportDirectory    Reports. Default: $(OutDir)wotr-reports/. WOTR_OFFLINE_REPORT_DIR overrides at run time.
      WotrIsLibrary          true for projects that only need the game references.
      WotrRuntime            mono (default) or netfx for dotnet test.
      WotrTestTimeoutSeconds Session timeout, default 900; explicit user runsettings take precedence.
      WotrMinimumPassed      Minimum passing tests, default 1; skips do not count.
      WotrXunitConsoleVersion  xUnit v2 console runner used by Invoke-WotrOfflineTests.ps1 -Runtime mono (default 2.9.2).
      WotrDlc                Which DLCs are available offline: all (default), none, local (installed in the Steam library)
                             or a comma-separated list of DLC blueprint names (Dlc4,Dlc6). WOTR_DLC overrides at run time.
      WotrHarmony            The 0Harmony.dll the run loads: umm (default, UnityModManager's copy), game (the game's own
                             Wrath_Data/Managed copy) or a file path. WOTR_HARMONY overrides at run time.
      WotrHarmonyReference   Items: Harmony copies (umm, game or file paths) mods are compared with; missing members are
                             warned. Default: game. WOTR_HARMONY_REFERENCES ('|'-separated) overrides at run time.
      WotrGenerateModuleInitializer  false to skip the generated module initializer (then call
                             OfflineRuntime.InstallResolver() from your own before any game type is touched).
  -->

  <PropertyGroup>
    <WotrInputRoot Condition="'$(WotrInputRoot)'==''">$([System.Environment]::GetEnvironmentVariable('WOTR_INPUT_ROOT'))</WotrInputRoot>
    <WotrInputRoot Condition="'$(WotrInputRoot)'=='' and '$(WotrSnapshotDirectory)'!='' and Exists('$(WotrSnapshotDirectory)/manifest.json')">$(WotrSnapshotDirectory)</WotrInputRoot>
    <WrathInstallDir Condition="'$(WrathInstallDir)'==''">$(WrathPath)</WrathInstallDir>
    <WrathInstallDir Condition="'$(WrathInstallDir)'==''">$([System.Environment]::GetEnvironmentVariable('WrathPath'))</WrathInstallDir>
    <WrathInstallDir Condition="'$(WrathInstallDir)'==''">$([System.Environment]::GetEnvironmentVariable('WRATH_PATH'))</WrathInstallDir>
    <WotrInputRoot Condition="'$(WotrInputRoot)'==''">$(WrathInstallDir)</WotrInputRoot>
    <WotrManaged>$(WotrInputRoot)/Wrath_Data/Managed</WotrManaged>
    <WotrWorkDirectory Condition="'$(WotrWorkDirectory)'==''">$(BaseIntermediateOutputPath)wotr/</WotrWorkDirectory>
    <WotrXunitConsoleVersion Condition="'$(WotrXunitConsoleVersion)'==''">2.9.2</WotrXunitConsoleVersion>
    <WotrDlc Condition="'$(WotrDlc)'==''">all</WotrDlc>
    <WotrHarmony Condition="'$(WotrHarmony)'==''">umm</WotrHarmony>
    <WotrRuntime Condition="'$(WotrRuntime)'==''">mono</WotrRuntime>
    <WotrTestTimeoutSeconds Condition="'$(WotrTestTimeoutSeconds)'==''">900</WotrTestTimeoutSeconds>
    <WotrMinimumPassed Condition="'$(WotrMinimumPassed)'==''">1</WotrMinimumPassed>
    <!-- Runner and snapshot scripts: tools/ in the NuGet package, scripts/ in the source repository. -->
    <WotrToolsDirectory Condition="'$(WotrToolsDirectory)'=='' and Exists('$(MSBuildThisFileDirectory)../tools/Invoke-WotrOfflineTests.ps1')">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../tools/'))</WotrToolsDirectory>
    <WotrToolsDirectory Condition="'$(WotrToolsDirectory)'==''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../scripts/'))</WotrToolsDirectory>
    <WotrRunnerDirectory Condition="Exists('$(MSBuildThisFileDirectory)../tools/WotR.Testing.MonoRuntimeProvider.dll')">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../tools/'))</WotrRunnerDirectory>
    <WotrBuildTasksAssembly Condition="'$(WotrRunnerDirectory)'!=''">$(WotrRunnerDirectory)WotR.Testing.Build.dll</WotrBuildTasksAssembly>
    <WotrMonoHost Condition="'$(WotrRunnerDirectory)'!=''">$(WotrRunnerDirectory)wotr-mono-host.exe</WotrMonoHost>
    <WotrBootstrapDirectory Condition="'$(WotrRunnerDirectory)'!=''">$(WotrRunnerDirectory)</WotrBootstrapDirectory>
    <WotrRunnerDirectory Condition="'$(WotrRunnerDirectory)'==''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../artifacts/bin/WotR.Testing.VSTest/$(Configuration)/netstandard2.0/'))</WotrRunnerDirectory>
    <WotrBuildTasksAssembly Condition="'$(WotrBuildTasksAssembly)'==''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../artifacts/bin/WotR.Testing.Build/$(Configuration)/netstandard2.0/WotR.Testing.Build.dll'))</WotrBuildTasksAssembly>
    <WotrMonoHost Condition="'$(WotrMonoHost)'==''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../artifacts/bin/WotR.Testing.MonoHost/$(Configuration)/wotr-mono-host.exe'))</WotrMonoHost>
    <WotrBootstrapDirectory Condition="'$(WotrBootstrapDirectory)'==''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../artifacts/bin/WotR.Testing.VSTestBootstrap/$(Configuration)/net8.0/'))</WotrBootstrapDirectory>
  </PropertyGroup>

  <UsingTask TaskName="WotR.Testing.Build.PrepareTestRun" AssemblyFile="$(WotrBuildTasksAssembly)" />
  <UsingTask TaskName="WotR.Testing.Build.ValidateTestRun" AssemblyFile="$(WotrBuildTasksAssembly)" />

  <Target Name="EnsureWotrTestProject" BeforeTargets="VSTest" Condition="'$(WotrIsLibrary)'!='true' and '$(WotrLegacyRunner)'!='true'">
    <Error Condition="'$(IsTestProject)'!='true'" Text="[TEST_PROJECT_REQUIRED] No test project was registered. Reference Microsoft.NET.Test.Sdk and a test framework with its VSTest adapter. Use WotrIsLibrary=true only for a library that needs compile-time references." />
  </Target>

  <!-- Keep VSTest's own discovery, adapters, filters, loggers and exit handling. Only its runtime provider changes. -->
  <Target Name="PrepareWotrDotnetTest" BeforeTargets="_VSTestConsole;_VSTestMSBuild" Condition="'$(WotrIsLibrary)'!='true' and '$(IsTestProject)'=='true' and '$(WotrLegacyRunner)'!='true'">
    <CallTarget Targets="BuildProject" Condition="'$(VSTestNoBuild)'!='true'" />
    <PropertyGroup>
      <_WotrOriginalSettings>$([MSBuild]::ValueOrDefault('$(VSTestSetting)', '$(RunSettingsFilePath)'))</_WotrOriginalSettings>
      <WotrReportDirectory Condition="'$(WotrReportDirectory)'=='' and '$(VSTestResultsDirectory)'!=''">$(VSTestResultsDirectory)/wotr/$(MSBuildProjectName)/</WotrReportDirectory>
      <WotrReportDirectory Condition="'$(WotrReportDirectory)'==''">$(TargetDir)wotr-reports/</WotrReportDirectory>
    </PropertyGroup>
    <WotR.Testing.Build.PrepareTestRun WorkDirectory="$(WotrWorkDirectory)" InputRoot="$(WotrInputRoot)"
        MonoHost="$(WotrMonoHost)" RunnerDirectory="$(WotrRunnerDirectory)" Runtime="$(WotrRuntime)" OriginalConsole="$(VSTestConsolePath)" BootstrapDirectory="$(WotrBootstrapDirectory)" SourceDirectory="$(TargetDir)"
        OriginalSettings="$(_WotrOriginalSettings)" OriginalAdapterPath="$(VSTestTestAdapterPath)"
        ReportDirectory="$(WotrReportDirectory)" TimeoutSeconds="$(WotrTestTimeoutSeconds)">
      <Output TaskParameter="PreparedSettings" PropertyName="VSTestSetting" />
      <Output TaskParameter="AdapterPath" PropertyName="VSTestTestAdapterPath" />
      <Output TaskParameter="RunReport" PropertyName="_WotrRunReport" />
      <Output TaskParameter="EnvironmentDirectory" PropertyName="_WotrEnvironmentDirectory" />
      <Output TaskParameter="PreparedConsole" PropertyName="VSTestConsolePath" />
    </WotR.Testing.Build.PrepareTestRun>
  </Target>

  <Target Name="ValidateWotrDotnetTest" AfterTargets="_VSTestConsole;_VSTestMSBuild"
      Condition="'$(WotrIsLibrary)'!='true' and '$(IsTestProject)'=='true' and '$(VSTestListTests)'!='true' and '$(WotrLegacyRunner)'!='true'">
    <WotR.Testing.Build.ValidateTestRun RunReport="$(_WotrRunReport)" EnvironmentDirectory="$(_WotrEnvironmentDirectory)" MinimumPassed="$(WotrMinimumPassed)" Runtime="$(WotrRuntime)" />
  </Target>

  <!-- Runner for Invoke-WotrOfflineTests.ps1 -Runtime mono: downloaded into the NuGet cache, never referenced. -->
  <ItemGroup Condition="'$(WotrIsLibrary)'!='true'">
    <PackageDownload Include="xunit.runner.console" Version="[$(WotrXunitConsoleVersion)]" />
  </ItemGroup>

  <Target Name="EnsureWotrInputs" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(WotrInputRoot)'=='' or !Exists('$(WotrManaged)/Assembly-CSharp.dll')"
           Text="[ENV_MISSING] WotR inputs not found. Set WotrInputRoot or WOTR_INPUT_ROOT, create a snapshot with New-WotrSnapshot.ps1, or set WrathInstallDir." />
    <Error Condition="'$(WotrIsLibrary)'!='true' and '$(WotrModAssembly)'==''" Text="[ENV_MISSING] Set WotrModAssembly to the built mod DLL." />
  </Target>

  <!-- Compile-time only: at run time every game, Harmony and mod assembly comes from the prepared runtime folder. -->
  <ItemGroup>
    <Reference Include="$(WotrManaged)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(WotrManaged)/Assembly-CSharp-firstpass.dll" Private="false" />
    <Reference Include="$(WotrManaged)/Owlcat.Runtime.Core.dll" Private="false" />
    <Reference Include="$(WotrManaged)/Owlcat.SharedTypes.dll" Private="false" />
    <Reference Include="$(WotrManaged)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(WotrManaged)/UnityModManager/UnityModManager.dll" Private="false" />
    <Reference Include="$(WotrManaged)/UnityModManager/0Harmony.dll" Private="false" />
    <Reference Include="$(WotrModAssembly)" Private="false" Condition="'$(WotrIsLibrary)'!='true'" />
  </ItemGroup>

  <!-- In a target, so WotrDependencyMod items declared after the Import are seen. -->
  <Target Name="AddWotrDependencyModReferences" BeforeTargets="ResolveAssemblyReferences" Condition="'$(WotrIsLibrary)'!='true'">
    <Error Condition="'%(WotrDependencyMod.Identity)'!='' and !Exists('%(WotrDependencyMod.FullPath)')" Text="[ENV_MISSING] WotrDependencyMod not found: %(WotrDependencyMod.FullPath)" />
    <ItemGroup>
      <Reference Include="@(WotrDependencyMod->'%(FullPath)')" Private="false" />
    </ItemGroup>
  </Target>

  <Target Name="WriteWotrOfflineInputs" BeforeTargets="CoreCompile" Condition="'$(WotrIsLibrary)'!='true'">
    <PropertyGroup>
      <WotrReportDirectory Condition="'$(WotrReportDirectory)'==''">$(OutDir)wotr-reports/</WotrReportDirectory>
      <!-- '|'-separated: WriteLinesToFile would split a ';' list into lines. -->
      <_WotrDependencyMods>@(WotrDependencyMod->'%(FullPath)', '|')</_WotrDependencyMods>
      <_WotrHarmony>$(WotrHarmony)</_WotrHarmony>
      <_WotrHarmony Condition="'$(WotrHarmony)'!='umm' and '$(WotrHarmony)'!='game'">$([System.IO.Path]::GetFullPath('$(WotrHarmony)'))</_WotrHarmony>
      <_WotrHarmonyReferences>@(WotrHarmonyReference->'%(Identity)', '|')</_WotrHarmonyReferences>
      <_WotrHarmonyReferences Condition="'$(_WotrHarmonyReferences)'==''">game</_WotrHarmonyReferences>
      <_WotrInputsJson>{
  "inputRoot": "$([System.IO.Path]::GetFullPath('$(WotrInputRoot)').Replace('\','/'))",
  "modAssembly": "$([System.IO.Path]::GetFullPath('$(WotrModAssembly)').Replace('\','/'))",
  "dependencyMods": "$(_WotrDependencyMods.Replace('\','/'))",
  "workDirectory": "$([System.IO.Path]::GetFullPath('$(WotrWorkDirectory)').Replace('\','/'))",
  "dlc": "$(WotrDlc.Replace(';', ','))",
  "harmony": "$(_WotrHarmony.Replace('\','/'))",
  "harmonyReferences": "$(_WotrHarmonyReferences.Replace('\','/'))",
  "reportDirectory": "$([System.IO.Path]::GetFullPath('$(WotrReportDirectory)').Replace('\','/'))"
}</_WotrInputsJson>
    </PropertyGroup>
    <WriteLinesToFile File="$(OutDir)wotr-offline-inputs.json" Lines="$(_WotrInputsJson)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
  <!--
    Installs the game assembly resolver as soon as the test assembly loads, so test frameworks can reflect on test
    classes that use game types in fields and signatures before any fixture runs.
  -->
  <Target Name="GenerateWotrModuleInitializer" BeforeTargets="CoreCompile"
          Condition="'$(WotrIsLibrary)'!='true' and '$(WotrGenerateModuleInitializer)'!='false'">
    <PropertyGroup>
      <_WotrInitializerFile>$(IntermediateOutputPath)WotrModuleInitializer.g.cs</_WotrInitializerFile>
      <_WotrInitializerSource>// Generated by WotR.Testing.Offline.targets.
namespace WotR.Testing.Offline.Generated
{
    internal static class WotrModuleInitializer
    {
        [System.Runtime.CompilerServices.ModuleInitializer]
        internal static void Install() => global::WotR.Testing.Offline.OfflineRuntime.InstallResolver()%3B
    }
}

namespace System.Runtime.CompilerServices
{
    [System.AttributeUsage(System.AttributeTargets.Method, Inherited = false)]
    internal sealed class ModuleInitializerAttribute : System.Attribute { }
}
</_WotrInitializerSource>
    </PropertyGroup>
    <WriteLinesToFile File="$(_WotrInitializerFile)" Lines="$(_WotrInitializerSource)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_WotrInitializerFile)" />
      <FileWrites Include="$(_WotrInitializerFile)" />
    </ItemGroup>
  </Target>
</Project>
