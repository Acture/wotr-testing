<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Serves the external adapters over the in-game protocol, in the game's player (in-game host) and in the offline
    worker. References no test framework: WotR.Testing.Runner.Xunit is loaded beside the test project's xUnit.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>WotR.Testing.Runner</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <ProjectReference Include="../WotR.Testing.InGame.Protocol/WotR.Testing.InGame.Protocol.csproj" />
  </ItemGroup>

</Project>
