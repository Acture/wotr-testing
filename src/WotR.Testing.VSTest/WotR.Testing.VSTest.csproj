<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>WotR.Testing.MonoRuntimeProvider</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.TestPlatform.ObjectModel" Version="17.10.0" PrivateAssets="all" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" PrivateAssets="all" />
    <!-- The dotnet test process supplies this framework assembly (.NET SDK 8+). -->
    <PackageReference Include="System.Reflection.Metadata" Version="8.0.1" PrivateAssets="all" />
    <!-- Not referenced by the provider: placed in the same runner directory, which VSTest searches for adapters. -->
    <ProjectReference Include="../WotR.Testing.TestAdapter/WotR.Testing.TestAdapter.csproj" />
  </ItemGroup>
</Project>
