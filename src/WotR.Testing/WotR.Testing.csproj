<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Meta-package: no code, only dependencies on the WotR.Testing components (Offline and Fuzzing; in-game testing
    will be added here). Mod test projects reference this package.
  -->
  <Import Project="$(MSBuildThisFileDirectory)../../GamePath.props" Condition="Exists('$(MSBuildThisFileDirectory)../../GamePath.props')" />

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- NU5128: a meta-package has dependencies but no lib/ folder by design. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <PackageId>WotR.Testing</PackageId>
    <Authors>Acture</Authors>
    <Description>Test tooling for Pathfinder: Wrath of the Righteous mods. Offline tests run against the real game assemblies on Unity Mono without starting the game. Interface fuzzing automatically generates method calls and arguments, shrinks failures and replays saved cases. Game files come from your own installation and are never part of the packages.</Description>
    <PackageTags>pathfinder;wrath-of-the-righteous;wotr;modding;testing;unitymodmanager</PackageTags>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Acture/wotr-testing</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Acture/wotr-testing</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FsCheck.Xunit" Version="$(FsCheckXunitVersion)" />
    <!-- PrivateAssets none: the component's build targets reach the consumer (through its buildTransitive/ folder). -->
    <ProjectReference Include="../WotR.Testing.Offline/WotR.Testing.Offline.csproj" PrivateAssets="none" />
    <ProjectReference Include="../WotR.Testing.Fuzzing/WotR.Testing.Fuzzing.csproj" PrivateAssets="none" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE-EXCEPTION.md" Pack="true" PackagePath="/" />
    <WotrPackageEntry Include="WotR.Testing.nuspec;README.md;LICENSE-EXCEPTION.md" />
  </ItemGroup>
</Project>
