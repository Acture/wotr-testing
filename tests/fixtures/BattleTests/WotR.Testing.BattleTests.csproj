<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../GamePath.props" Condition="Exists('../../../GamePath.props')" />
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <Import Project="../../../src/WotR.Testing.Offline/build/WotR.Testing.Offline.targets" />
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
    <ProjectReference Include="../../../src/WotR.Testing.Offline/WotR.Testing.Offline.csproj" />
    <!-- netfx: xUnit must not shadow-copy the test assembly away from the generated input description. -->
    <Reference Include="$(WotrManaged)/UnityEngine.PhysicsModule.dll" Private="false" />
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="..\RuleMod\WotR.Testing.RuleMod.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\BattleSupport\WotR.Testing.BattleSupport.csproj" />
  </ItemGroup>
  <Target Name="BuildRuleMod" BeforeTargets="EnsureWotrInputs">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\RuleMod\WotR.Testing.RuleMod.csproj" Properties="Configuration=$(Configuration)" Targets="Build" />
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\RuleMod\WotR.Testing.RuleMod.csproj" Properties="Configuration=$(Configuration)" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="_RuleModAssembly" />
    </MSBuild>
    <PropertyGroup>
      <WotrModAssembly>%(_RuleModAssembly.FullPath)</WotrModAssembly>
    </PropertyGroup>
  </Target>
</Project>
