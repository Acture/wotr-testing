<Project Sdk="Microsoft.NET.Sdk">

  <!-- Synthetic offgame, in-game and fuzz cases for the runner integration tests. No game rules or data. -->
  <Import Project="../../../GamePath.props" Condition="Exists('../../../GamePath.props')" />
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <Import Project="../../../src/WotR.Testing.Offline/build/WotR.Testing.Offline.targets" />
  <PropertyGroup>
    <WotrModAssembly>$(MSBuildThisFileDirectory)../../../artifacts/bin/SyntheticMod/$(Configuration)/net48/SyntheticMod.dll</WotrModAssembly>
  </PropertyGroup>
  <ItemGroup>
    <!-- The synthetic mod is not installed in the game; check a module the game always loads instead. -->
    <WotrInGameMod Include="$(WotrInputRoot)/Wrath_Data/Managed/Assembly-CSharp.dll" />
    <ProjectReference Include="../SyntheticMod/SyntheticMod.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
    <ProjectReference Include="../../../src/WotR.Testing/WotR.Testing.csproj" />
    <ProjectReference Include="../../../src/WotR.Testing.InGame/WotR.Testing.InGame.csproj" />
    <Compile Include="../MonoTests/RuntimeReport.cs" Link="RuntimeReport.cs" />
  </ItemGroup>

</Project>
