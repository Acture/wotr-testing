<Project Sdk="Microsoft.NET.Sdk">

  <!-- Synthetic in-game cases for the runner integration tests. No game rules or data. -->
  <Import Project="$(MSBuildThisFileDirectory)../../../GamePath.props" Condition="Exists('$(MSBuildThisFileDirectory)../../../GamePath.props')" />

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <WotrManaged>$(WrathInstallDir)/Wrath_Data/Managed</WotrManaged>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <Reference Include="$(WotrManaged)/UnityEngine.CoreModule.dll" Private="false" />
    <ProjectReference Include="../../../src/WotR.Testing.InGame/WotR.Testing.InGame.csproj" />
  </ItemGroup>

</Project>
