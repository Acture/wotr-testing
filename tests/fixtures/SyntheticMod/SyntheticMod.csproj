<Project Sdk="Microsoft.NET.Sdk">

  <!-- The smallest mod the offline runtime accepts: an entry method and Info.json. No game rules. -->
  <Import Project="../../../GamePath.props" Condition="Exists('../../../GamePath.props')" />
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="$(WrathInstallDir)/Wrath_Data/Managed/UnityModManager/UnityModManager.dll" Private="false" />
    <None Include="Info.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
